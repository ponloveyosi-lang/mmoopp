           Rayfield:Notify({
               Title = "Warped Home!",
               Content = "วาร์ปกลับบ้านสำเร็จ",
               Duration = 3,
               Image = 4483362458,
           })
       else
           Rayfield:Notify({
               Title = "Warning",
               Content = "ไม่พบพิกัดบ้านอัตโนมัติ",
               Duration = 3,
               Image = 4483362458,
           })
       end
   end,
})

