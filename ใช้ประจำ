local function getItemValue(object)
    local valueObj = object:FindFirstChild("Value") 
        or object:FindFirstChild("Price") 
        or object:FindFirstChild("Cost") 
        or object:FindFirstChild("Money")
        or object:FindFirstChild("Amount")
        
    if valueObj and (valueObj:IsA("IntValue") or valueObj:IsA("NumberValue")) then
        return valueObj.Value
    end

    local attrValue = object:GetAttribute("Value") or object:GetAttribute("Price") or object:GetAttribute("Cost")
    if attrValue and type(attrValue) == "number" then
        return attrValue
    end

    local nameMatch = object.Name:match("(%d+)")
    if nameMatch then
        return tonumber(nameMatch)
    end

    return 0
end

local function findBestStealTarget()
    local highestValue = -1
    local targetPrompt = nil
    local targetCFrame = nil
    local targetName = "Unknown"

    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local parent = prompt.Parent
            if parent and not parent:IsDescendantOf(LocalPlayer.Character) then
                local val = getItemValue(parent)
                local cframe = nil
                if parent:IsA("BasePart") then
                    cframe = parent.CFrame
                elseif parent:IsA("Model") then
                    if parent.PrimaryPart then
                        cframe = parent.PrimaryPart.CFrame
                    else
                        local part = parent:FindFirstChildWhichIsA("BasePart")
                        if part then cframe = part.CFrame end
                    end
                end

                if cframe and val >= highestValue then
                    highestValue = val
                    targetPrompt = prompt
                    targetCFrame = cframe
                    targetName = parent.Name
                end
            end
        end
    end

    return targetCFrame, targetPrompt, highestValue, targetName
end

local function findHomePosition()
    local pName = LocalPlayer.Name:lower()
    local pDisplayName = LocalPlayer.DisplayName:lower()

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local text = obj.Text:lower()
            if text:find(pName) or text:find(pDisplayName) then
                local parentPart = obj:FindFirstAncestorWhichIsA("BasePart") or obj:FindFirstAncestorWhichIsA("Model")
                if parentPart then
                    if parentPart:IsA("BasePart") then
                        return parentPart.CFrame + Vector3.new(0, 5, 0)
                    elseif parentPart:IsA("Model") then
                        return parentPart:GetPivot() + Vector3.new(0, 5, 0)
                    end
                end
            end
        end
    end

    for _, spawn in ipairs(workspace:GetDescendants()) do
        if spawn:IsA("SpawnLocation") then
            return spawn.CFrame + Vector3.new(0, 5, 0)
        end
    end

    return nil
end

local function actionWarpAndSteal()
    local root = getRootPart()
    if not root then return end

    local targetCFrame, targetPrompt, valueFound, targetName = findBestStealTarget()

    if targetCFrame and targetPrompt then
        if not customHomeCFrame then
            customHomeCFrame = root.CFrame
        end

        root.CFrame = targetCFrame + Vector3.new(0, 2, 0)
        fireproximityprompt(targetPrompt)

        local displayValue = (valueFound > 0) and (tostring(valueFound) .. " บาท") or "มูลค่าสูงสุด"

        Rayfield:Notify({
            Title = "Steal Triggered!",
            Content = "วาร์ปไปขโมย: " .. targetName .. " (" .. displayValue .. ")",
            Duration = 3,
            Image = 4483362458,
        })
    else
        Rayfield:Notify({
            Title = "Error!",
            Content = "ไม่พบเป้าหมายที่มีปุ่มขโมย",
            Duration = 3,
            Image = 4483362458,
        })
    end
end

local function actionWarpHome()
    local root = getRootPart()
    if not root then return end

    if customHomeCFrame then
        root.CFrame = customHomeCFrame
        Rayfield:Notify({
            Title = "Warped Home!",
            Content = "วาร์ปกลับบ้านเรียบร้อยแล้ว",
            Duration = 3,
            Image = 4483362458,
        })
        return
    end

    local homeCFrame = findHomePosition()
    if homeCFrame then
        root.CFrame = homeCFrame
        Rayfield:Notify({
            Title = "Warped Home!",
            Content = "วาร์ปกลับบ้านสำเร็จ",
            Duration = 3,
            Image = 4483362458,
