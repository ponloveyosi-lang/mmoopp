-- ==========================================
-- 1. ระบบ Mobile True 3D Camera Fly Engine
-- ==========================================
local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")
local PlayerModule
pcall(function()
    PlayerModule = require(PlayerScripts:WaitForChild("PlayerModule"))
end)

local function GetMobileMoveVector()
    if PlayerModule then
        local controlModule = PlayerModule:GetControls()
        if controlModule then
            return controlModule:GetMoveVector()
        end
    end
    return Vector3.zero
end

local function StartFlying()
    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")

    if not HumanoidRootPart or not Humanoid then return end

    HumanoidRootPart.Anchored = true

    FlyRenderConnection = RunService.RenderStepped:Connect(function()
        if not Flying or not HumanoidRootPart then return end

        local rawInput = GetMobileMoveVector()
        
        if rawInput.Magnitude > 0 then
            local camCFrame = Camera.CFrame
            local forwardVector = camCFrame.LookVector * (-rawInput.Z)
            local rightVector = camCFrame.RightVector * rawInput.X
            local moveDirection = (forwardVector + rightVector)

            if moveDirection.Magnitude > 0 then
                HumanoidRootPart.CFrame = HumanoidRootPart.CFrame + (moveDirection.Unit * FlySpeed)
            end
        end

        HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position, HumanoidRootPart.Position + Camera.CFrame.LookVector)
    end)
end

local function StopFlying()
    if FlyRenderConnection then 
        FlyRenderConnection:Disconnect() 
        FlyRenderConnection = nil
    end

    local Character = LocalPlayer.Character
    if Character then
        local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
        if HumanoidRootPart then
            HumanoidRootPart.Anchored = false
        end
    end
end

local function toggleFlyState(state)
    Flying = state
    if Flying then
        StartFlying()
        if btnFlyRef then
            btnFlyRef.Text = "🚁 บิน: ON"
            btnFlyRef.TextColor3 = Color3.fromRGB(100, 255, 100)
        end
    else
        StopFlying()
        if btnFlyRef then
            btnFlyRef.Text = "🚁 บิน: OFF"
            btnFlyRef.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end

    if FlyToggleRef and FlyToggleRef.CurrentValue ~= state then
        FlyToggleRef:Set(state)
    end
end

