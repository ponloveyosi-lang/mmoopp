-- ==========================================
-- 4. ระบบ Mobile True 3D Camera Fly (บินตรงตามนิ้วโยกบนมือถือ 100%)
-- ==========================================
local Flying = false
local FlySpeed = 2
local FlyRenderConnection
local Camera = workspace.CurrentCamera

-- ดึงค่าการควบคุมจากจอยสติ๊กมือถือโดยตรง
local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")
local PlayerModule
pcall(function()
    PlayerModule = require(PlayerScripts:WaitForChild("PlayerModule"))
end)

local function GetMobileMoveVector()
    if PlayerModule then
        local controlModule = PlayerModule:GetControls()
        if controlModule then
            return controlModule:GetMoveVector()
        end
    end
    return Vector3.zero
end

local function StartFlying()
    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")

    if not HumanoidRootPart or not Humanoid then return end

    -- ล็อกตัวละครไม่ให้ร่วง
    HumanoidRootPart.Anchored = true

    FlyRenderConnection = RunService.RenderStepped:Connect(function()
        if not Flying or not HumanoidRootPart then return end

        -- อ่านค่านิ้วที่ดันจอยสติ๊กมือถือ (X = ซ้าย/ขวา, Z = หน้า/หลัง)
        local rawInput = GetMobileMoveVector()
        
        if rawInput.Magnitude > 0 then
            local camCFrame = Camera.CFrame
            
            -- คำนวณทิศทางตามกล้องจริงแบบ 3D (รวมก้ม/เงย)
            local forwardVector = camCFrame.LookVector * (-rawInput.Z)
            local rightVector = camCFrame.RightVector * rawInput.X
            local moveDirection = (forwardVector + rightVector)

            if moveDirection.Magnitude > 0 then
                HumanoidRootPart.CFrame = HumanoidRootPart.CFrame + (moveDirection.Unit * FlySpeed)
            end
        end

        -- หันหน้าตัวละครไปตามกล้องเสมอ
        HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position, HumanoidRootPart.Position + Camera.CFrame.LookVector)
    end)
end

local function StopFlying()
    if FlyRenderConnection then FlyRenderConnection:Disconnect() end

    local Character = LocalPlayer.Character
    if Character then
        local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
        if HumanoidRootPart then
            HumanoidRootPart.Anchored = false
        end
    end
end

MainTab:CreateSection("Mobile Fly System")

MainTab:CreateToggle({
    Name = "เปิด / ปิด บิน (Toggle Fly)",
    CurrentValue = false,
    Flag = "FlyToggle",
    Callback = function(Value)
        Flying = Value
        if Flying then
            StartFlying()
        else
            StopFlying()
        end
    end,
})

MainTab:CreateSlider({
    Name = "ความเร็วบิน (Fly Speed)",
    Range = {1, 10},
    Increment = 0.5,
    Suffix = " Multiplier",
