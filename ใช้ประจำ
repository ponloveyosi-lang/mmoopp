    else
        Rayfield:Notify({
            Title = "Warning",
            Content = "ไม่พบพิกัดบ้านอัตโนมัติ",
            Duration = 3,
            Image = 4483362458,
        })
    end
end

local function actionWarpToMarked()
    local root = getRootPart()
    if root then
        if markedCFrame then
            root.CFrame = markedCFrame
