-- 3. ระบบ Walk Speed Controller
-- ==========================================
local defaultSpeed = 16
local targetSpeed = 16
local isSpeedEnabled = false
local speedLoop = nil

local function updateSpeed()
    if LocalPlayer and LocalPlayer.Character then
        local Humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if Humanoid then
            Humanoid.WalkSpeed = isSpeedEnabled and targetSpeed or defaultSpeed
        end
    end
end

-- ==========================================
-- 4. ระบบ Auto Steal & Home Helper Functions
-- ==========================================
local function getItemValue(object)
    local valueObj = object:FindFirstChild("Value") 
        or object:FindFirstChild("Price") 
        or object:FindFirstChild("Cost") 
        or object:FindFirstChild("Money")
        or object:FindFirstChild("Amount")
        
    if valueObj and (valueObj:IsA("IntValue") or valueObj:IsA("NumberValue")) then
        return valueObj.Value
    end

    local attrValue = object:GetAttribute("Value") or object:GetAttribute("Price") or object:GetAttribute("Cost")
    if attrValue and type(attrValue) == "number" then
        return attrValue
    end

    local nameMatch = object.Name:match("(%d+)")
    if nameMatch then
        return tonumber(nameMatch)
    end

    return 0
end

local function findBestStealTarget()
    local highestValue = -1
    local targetPrompt = nil
    local targetCFrame = nil
    local targetName = "Unknown"

    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local parent = prompt.Parent
            if parent and not parent:IsDescendantOf(LocalPlayer.Character) then
                local val = getItemValue(parent)
                local cframe = nil
                if parent:IsA("BasePart") then
                    cframe = parent.CFrame
                elseif parent:IsA("Model") then
                    if parent.PrimaryPart then
                        cframe = parent.PrimaryPart.CFrame
                    else
                        local part = parent:FindFirstChildWhichIsA("BasePart")
                        if part then cframe = part.CFrame end
                    end
                end

                if cframe and val >= highestValue then
                    highestValue = val
                    targetPrompt = prompt
                    targetCFrame = cframe
                    targetName = parent.Name
                end
            end
        end
    end

    return targetCFrame, targetPrompt, highestValue, targetName
end

local function findHomePosition()
    local pName = LocalPlayer.Name:lower()
    local pDisplayName = LocalPlayer.DisplayName:lower()

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local text = obj.Text:lower()
            if text:find(pName) or text:find(pDisplayName) then
                local parentPart = obj:FindFirstAncestorWhichIsA("BasePart") or obj:FindFirstAncestorWhichIsA("Model")
                if parentPart then
                    if parentPart:IsA("BasePart") then
                        return parentPart.CFrame + Vector3.new(0, 5, 0)
                    elseif parentPart:IsA("Model") then
                        return parentPart:GetPivot() + Vector3.new(0, 5, 0)
                    end
                end
            end
        end
    end

    for _, spawn in ipairs(workspace:GetDescendants()) do
        if spawn:IsA("SpawnLocation") then
            return spawn.CFrame + Vector3.new(0, 5, 0)
        end
    end

    return nil
end

-- ==========================================
-- 5. ระบบ Mobile True 3D Camera Fly
-- ==========================================
local Flying = false
local FlySpeed = 2
local FlyRenderConnection

local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")
local PlayerModule
pcall(function()
    PlayerModule = require(PlayerScripts:WaitForChild("PlayerModule"))
end)

local function GetMobileMoveVector()
    if PlayerModule then
        local controlModule = PlayerModule:GetControls()
        if controlModule then
            return controlModule:GetMoveVector()
        end
    end
    return Vector3.zero
end

local function StartFlying()
    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
    if not HumanoidRootPart then return end

    HumanoidRootPart.Anchored = true

    FlyRenderConnection = RunService.RenderStepped:Connect(function()
        if not Flying or not HumanoidRootPart then return end

        local rawInput = GetMobileMoveVector()
        if rawInput.Magnitude > 0 then
            local camCFrame = Camera.CFrame
            local forwardVector = camCFrame.LookVector * (-rawInput.Z)
            local rightVector = camCFrame.RightVector * rawInput.X
            local moveDirection = (forwardVector + rightVector)

            if moveDirection.Magnitude > 0 then
                HumanoidRootPart.CFrame = HumanoidRootPart.CFrame + (moveDirection.Unit * FlySpeed)
            end
        end

        HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position, HumanoidRootPart.Position + Camera.CFrame.LookVector)
    end)
end

local function StopFlying()
    if FlyRenderConnection then FlyRenderConnection:Disconnect() end
    local Character = LocalPlayer.Character
    if Character then
        local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
        if HumanoidRootPart then
            HumanoidRootPart.Anchored = false
        end
    end
end

